# Digital factory production settings. Copy to .env on the droplet, fill in, chmod 600.
# Generate every secret with: openssl rand -base64 32
# Full reference: ../../docs/configuration.md and ../../docs/deployment.md

# Release to run, for both images. Pin a tag; update deliberately (see README, "Update").
OPENBOT_VERSION=v0.2.0

# Public address. DNS A record for this name points at the droplet's IP.
OPENBOT_DOMAIN=factory.example.com
BETTER_AUTH_URL=https://factory.example.com
TRUSTED_ORIGINS=https://factory.example.com
NODE_ENV=production

# Sign-in with the company Google Workspace. OAuth client redirect URI:
#   https://factory.example.com/api/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
BETTER_AUTH_SECRET=
INITIAL_ADMIN_EMAILS=
SIGNIN_ALLOWED_EMAIL_DOMAINS=

# Encrypts stored credentials. Back this up somewhere other than the droplet: losing it loses them.
KEY_ENCRYPTION_KEY=

# CopilotKit Intelligence (free managed plan): threads and memory.
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
INTELLIGENCE_API_KEY=

# Claude. Set exactly ONE of the two blocks.
# 1. Company Claude plan: run `claude setup-token` signed in as the company account.
CLAUDE_CODE_OAUTH_TOKEN=
# 2. Fallback, billed per token. Put a spending cap on the key in the Anthropic Console.
# BOT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Shared between the server and the Claude harness.
MANAGED_AGENT_TOKEN=
# Lets Bots call tools back through the server's gateway.
AGENT_TOOL_TOKEN=
# Lets the routine sweep hand runs to the server. Empty means routines never fire.
WORKER_SHARED_SECRET=

# Slack through OpenTag (AP-88). Start with: docker compose --env-file .env --profile slack up -d
# Shared secret between OpenBot and OpenTag, at least 32 characters.
OPENTAG_SHARED_SECRET=
OPENTAG_URL=http://opentag:3000
# The Slack app's Bot User OAuth Token (xoxb-), from api.slack.com/apps, the app, OAuth & Permissions.
# OpenTag posts with it when OpenBot sends outside a live turn. Empty means those sends fail visibly.
OPENTAG_SLACK_BOT_TOKEN=
# The managed Slack channel's name in CopilotKit Intelligence (see README, "Slack").
INTELLIGENCE_CHANNEL_NAME=digital-factory
