{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(npx -y modern-web-guidance@latest:*)",
      "Bash(pnpx modern-web-guidance@latest:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git submodule update --init --quiet .agents/shared || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-ai-credit.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pstack@ascentwright": true,
    "ascentwright@ascentwright": true,
    "modern-web-guidance@ascentwright": true
  },
  "extraKnownMarketplaces": {
    "ascentwright": {
      "source": {
        "source": "directory",
        "path": "./.agents/shared"
      }
    }
  }
}
